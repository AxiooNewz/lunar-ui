function LunarBanner.Show()
    local ok, executor = pcall(identifyexecutor)
    if not ok or type(executor) ~= "string" then executor = "Unknown" end
    local rule = string.rep("=", 54)
    LunarBanner.Print(table.concat({
        rule,
        "   LUNAR CLIENT  //  BREAK AND STEAL AN EGG  //  by Lunar Team",
        rule,
        "   executor: " .. executor .. "   //   player: " .. game:GetService("Players").LocalPlayer.Name,
        "   contact: @ser4ph1neee  //  t.me/ser4ph1neee",
        rule,
    }, "\n"))
end

function LunarBanner.Step(label)
    local now = os.clock()
    LunarBanner.Done = math.min(LunarBanner.Done + 1, LunarBanner.Total)
    local filled = math.floor(LunarBanner.Done / LunarBanner.Total * 20 + 0.5)
    LunarBanner.Print(string.format("[Lunar] [%s] %3d%%  %-24s +%dms", string.rep("#", filled)..string.rep(".", 20-filled), math.floor(LunarBanner.Done / LunarBanner.Total * 100), label, math.floor((now - LunarBanner.Last) * 1000)))
    LunarBanner.Last = now
end

function LunarBanner.Ready()
    local rule = string.rep("=", 54)
    LunarBanner.Print(table.concat({rule, string.format("   >> READY in %dms", math.floor((os.clock() - LunarBanner.Started) * 1000)), rule}, "\n"))
end

